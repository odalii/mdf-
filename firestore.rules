rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp;
    }

    // --- User Profile Validation ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    // --- Company Settings Validation ---
    function isValidCompanySettings(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'companyName', 'currency', 'defaultSheetLength',
          'defaultSheetWidth', 'defaultThickness', 'defaultCostPerSheet',
          'defaultMaterialType', 'defaultKerf', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyName', 'logoDataUrl', 'contactEmail', 'contactPhone',
          'address', 'currency', 'defaultSheetLength', 'defaultSheetWidth',
          'defaultThickness', 'defaultCostPerSheet', 'defaultMaterialType',
          'defaultKerf', 'theme', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.companyName is string && data.companyName.size() <= 120
        && (!('logoDataUrl' in data) || (data.logoDataUrl is string && data.logoDataUrl.size() <= 200000))
        && (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 254))
        && (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 40))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8
        && data.defaultSheetLength is number && data.defaultSheetLength > 0 && data.defaultSheetLength <= 10000
        && data.defaultSheetWidth is number && data.defaultSheetWidth > 0 && data.defaultSheetWidth <= 10000
        && data.defaultThickness is number && data.defaultThickness > 0 && data.defaultThickness <= 200
        && data.defaultCostPerSheet is number && data.defaultCostPerSheet >= 0 && data.defaultCostPerSheet <= 1000000
        && data.defaultMaterialType is string && data.defaultMaterialType.size() >= 1 && data.defaultMaterialType.size() <= 80
        && data.defaultKerf is number && data.defaultKerf >= 0 && data.defaultKerf <= 50
        && (!('theme' in data) || (data.theme is string && data.theme in ['light', 'dark']))
        && isValidTimestamp(data.updatedAt);
    }

    // --- Sheet Config & Summary Map Validation ---
    function isValidSheetConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll(['length', 'width', 'thickness', 'costPerSheet', 'materialType', 'kerf', 'allowRotation'])
        && cfg.keys().hasOnly(['length', 'width', 'thickness', 'costPerSheet', 'materialType', 'kerf', 'allowRotation', 'trimMargin'])
        && cfg.length is number && cfg.length > 0 && cfg.length <= 10000
        && cfg.width is number && cfg.width > 0 && cfg.width <= 10000
        && cfg.thickness is number && cfg.thickness > 0 && cfg.thickness <= 200
        && cfg.costPerSheet is number && cfg.costPerSheet >= 0 && cfg.costPerSheet <= 1000000
        && cfg.materialType is string && cfg.materialType.size() >= 1 && cfg.materialType.size() <= 80
        && cfg.kerf is number && cfg.kerf >= 0 && cfg.kerf <= 50
        && cfg.allowRotation is bool
        && (!('trimMargin' in cfg) || (cfg.trimMargin is number && cfg.trimMargin >= 0 && cfg.trimMargin <= 200));
    }

    function isValidSummary(sum) {
      return sum is map
        && sum.keys().hasAll(['totalSheets', 'efficiencyPct', 'wastePct', 'totalMaterialCost', 'usedAreaSqM', 'wasteAreaSqM'])
        && sum.keys().hasOnly(['totalSheets', 'efficiencyPct', 'wastePct', 'totalMaterialCost', 'usedAreaSqM', 'wasteAreaSqM', 'totalPartsPlaced'])
        && sum.totalSheets is number && sum.totalSheets >= 0 && sum.totalSheets <= 10000
        && sum.efficiencyPct is number && sum.efficiencyPct >= 0 && sum.efficiencyPct <= 100
        && sum.wastePct is number && sum.wastePct >= 0 && sum.wastePct <= 100
        && sum.totalMaterialCost is number && sum.totalMaterialCost >= 0
        && sum.usedAreaSqM is number && sum.usedAreaSqM >= 0
        && sum.wasteAreaSqM is number && sum.wasteAreaSqM >= 0
        && (!('totalPartsPlaced' in sum) || (sum.totalPartsPlaced is number && sum.totalPartsPlaced >= 0));
    }

    // --- Project Validation ---
    function isValidProject(data, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'status', 'sheetConfig', 'parts', 'summary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'customerName', 'notes', 'status', 'sheetConfig', 'parts', 'summary', 'shareId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == projectId && isValidId(data.id)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.status is string && data.status in ['draft', 'optimized', 'archived']
        && isValidSheetConfig(data.sheetConfig)
        && data.parts is list && data.parts.size() <= 300
        && (data.parts.size() == 0 || data.parts[0] is map)
        && isValidSummary(data.summary)
        && (!('shareId' in data) || (data.shareId is string && data.shareId.size() <= 64))
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    // --- Report Validation ---
    function isValidReport(data, projectId, reportId) {
      return data.keys().hasAll(['id', 'projectId', 'ownerId', 'fileName', 'totalSheets', 'efficiencyPct', 'totalCost', 'createdAt'])
        && data.keys().hasOnly(['id', 'projectId', 'ownerId', 'fileName', 'storagePath', 'downloadUrl', 'totalSheets', 'efficiencyPct', 'totalCost', 'createdAt'])
        && data.id is string && data.id == reportId && isValidId(data.id)
        && data.projectId is string && data.projectId == projectId && isValidId(data.projectId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
        && (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 300))
        && (!('downloadUrl' in data) || (data.downloadUrl is string && data.downloadUrl.size() <= 1000))
        && data.totalSheets is number && data.totalSheets >= 0
        && data.efficiencyPct is number && data.efficiencyPct >= 0 && data.efficiencyPct <= 100
        && data.totalCost is number && data.totalCost >= 0
        && isValidTimestamp(data.createdAt);
    }

    // --- Shared Project Snapshot Validation ---
    function isValidSharedSnapshot(data, shareId) {
      return data.keys().hasAll(['shareId', 'projectId', 'ownerId', 'name', 'sheetConfig', 'parts', 'summary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['shareId', 'projectId', 'ownerId', 'name', 'companyName', 'sheetConfig', 'parts', 'summary', 'createdAt', 'updatedAt'])
        && data.shareId is string && data.shareId == shareId && isValidId(data.shareId)
        && data.projectId is string && isValidId(data.projectId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 120))
        && isValidSheetConfig(data.sheetConfig)
        && data.parts is list && data.parts.size() <= 300
        && (data.parts.size() == 0 || data.parts[0] is map)
        && isValidSummary(data.summary)
        && isValidTimestamp(data.createdAt)
        && isValidTimestamp(data.updatedAt);
    }

    // --- Collection Rules ---

    // 1. User Profiles (PII strictly isolated to owner)
    match /users/{userId} {
      allow list: if false;
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isVerified() && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerified() && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerified() && isOwner(userId);

      // 2. Company Settings (subcollection under user)
      match /company/{settingId} {
        allow list: if isOwner(userId);
        allow get: if isValidId(settingId) && isOwner(userId);
        allow create: if isValidId(settingId) && isVerified() && isOwner(userId)
          && isValidCompanySettings(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(settingId) && isVerified() && isOwner(userId)
          && isValidCompanySettings(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'companyName', 'logoDataUrl', 'contactEmail', 'contactPhone', 'address',
            'currency', 'defaultSheetLength', 'defaultSheetWidth', 'defaultThickness',
            'defaultCostPerSheet', 'defaultMaterialType', 'defaultKerf', 'theme', 'updatedAt'
          ]);
        allow delete: if isValidId(settingId) && isVerified() && isOwner(userId);
      }
    }

    // 3. Cutting Projects
    match /projects/{projectId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isValidId(projectId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(projectId) && isVerified()
        && isValidProject(incoming(), projectId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId) && isVerified()
        && isValidProject(incoming(), projectId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'archived'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'customerName', 'notes', 'status', 'sheetConfig', 'parts', 'summary', 'shareId', 'updatedAt'
        ]);
      allow delete: if isValidId(projectId) && isVerified() && existing().ownerId == request.auth.uid;

      // 4. Saved PDF Reports (Master Gate to parent project)
      match /reports/{reportId} {
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow get: if isValidId(reportId) && isSignedIn()
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow create: if isValidId(reportId) && isVerified()
          && isValidReport(incoming(), projectId, reportId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(reportId) && isVerified()
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }

    // 5. Public Shareable Project Snapshots (No PII, no listing)
    match /sharedProjects/{shareId} {
      allow list: if false;
      allow get: if isValidId(shareId);
      allow create: if isValidId(shareId) && isVerified()
        && isValidSharedSnapshot(incoming(), shareId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(shareId) && isVerified()
        && isValidSharedSnapshot(incoming(), shareId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().shareId == existing().shareId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'companyName', 'sheetConfig', 'parts', 'summary', 'updatedAt'
        ]);
      allow delete: if isValidId(shareId) && isVerified() && existing().ownerId == request.auth.uid;
    }
  }
}

{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile with strict owner-only PII isolation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "User email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Workshop company branding and default MDF cutting parameters.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "logoDataUrl": {
          "type": "string",
          "maxLength": 200000
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 254
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "defaultSheetLength": {
          "type": "number"
        },
        "defaultSheetWidth": {
          "type": "number"
        },
        "defaultThickness": {
          "type": "number"
        },
        "defaultCostPerSheet": {
          "type": "number"
        },
        "defaultMaterialType": {
          "type": "string",
          "maxLength": 80
        },
        "defaultKerf": {
          "type": "number"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "companyName",
        "currency",
        "defaultSheetLength",
        "defaultSheetWidth",
        "defaultThickness",
        "defaultCostPerSheet",
        "defaultMaterialType",
        "defaultKerf",
        "updatedAt"
      ]
    },
    "CuttingProject": {
      "title": "CuttingProject",
      "description": "MDF board cutting optimization project owned by an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerName": {
          "type": "string",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["draft", "optimized", "archived"]
        },
        "sheetConfig": {
          "type": "object",
          "description": "MDF sheet dimensions, material type, cost, and kerf settings."
        },
        "parts": {
          "type": "array",
          "description": "Array of parts to cut (bounded to 300 items)."
        },
        "summary": {
          "type": "object",
          "description": "Calculated optimization summary metrics."
        },
        "shareId": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "status",
        "sheetConfig",
        "parts",
        "summary",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectReport": {
      "title": "ProjectReport",
      "description": "Saved PDF cutting report metadata and cloud storage reference.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "storagePath": {
          "type": "string",
          "maxLength": 300
        },
        "downloadUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "totalSheets": {
          "type": "number"
        },
        "efficiencyPct": {
          "type": "number"
        },
        "totalCost": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "projectId",
        "ownerId",
        "fileName",
        "totalSheets",
        "efficiencyPct",
        "totalCost",
        "createdAt"
      ]
    },
    "SharedProjectSnapshot": {
      "title": "SharedProjectSnapshot",
      "description": "Read-only shareable link snapshot of a cutting layout without owner PII.",
      "type": "object",
      "properties": {
        "shareId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "companyName": {
          "type": "string",
          "maxLength": 120
        },
        "sheetConfig": {
          "type": "object"
        },
        "parts": {
          "type": "array"
        },
        "summary": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "shareId",
        "projectId",
        "ownerId",
        "name",
        "sheetConfig",
        "parts",
        "summary",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile document containing PII."
    },
    "/users/{userId}/company/{settingId}": {
      "schema": { "$ref": "#/entities/CompanySettings" },
      "description": "Owner-only workshop company settings and default MDF specs."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/CuttingProject" },
      "description": "MDF board cutting optimization projects owned by users."
    },
    "/projects/{projectId}/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ProjectReport" },
      "description": "Saved PDF cutting report metadata linked to a parent project."
    },
    "/sharedProjects/{shareId}": {
      "schema": { "$ref": "#/entities/SharedProjectSnapshot" },
      "description": "Non-PII cutting plan snapshots accessible strictly by exact shareId get."
    }
  }
}
